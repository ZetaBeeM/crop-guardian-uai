AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_AGENT1_NAME=
AZURE_AI_AGENT2_NAME=
AZURE_AI_AGENT3_NAME=
AZURE_AI_AGENT4_NAME=
AZURE_AI_AGENT5_NAME=
COSMOS_URI=
COSMOS_KEY=

# Service principal para Foundry. En local DefaultAzureCredential usa el login
# de la CLI, pero en el contenedor no hay CLI ni identidad administrada.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Solo desarrollo local: DEV_AGRICULTOR_ID solo vale si ENTORNO=local. En
# cualquier otro caso la API exige la cabecera de identidad y responde 401.
ENTORNO=local
DEV_AGRICULTOR_ID=agricultor-demo

# LM Studio. Desde un contenedor, 127.0.0.1 seria el propio contenedor.
# Requiere --add-host=host.docker.internal:host-gateway.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
